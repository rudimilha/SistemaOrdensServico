@model IEnumerable<SistemaOrdensServico.Models.Tecnico>

@{
    ViewData["Title"] = "Técnicos";
}

<h1>Técnicos</h1>

<p>
    <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar Novo Técnico</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Telefone</th>
            <th>E-mail</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var tecnico in Model)
        {
            <tr>
                <td>@tecnico.Nome</td>
                <td>@tecnico.Telefone</td>
                <td>@tecnico.Email</td>
                <td>
                    <a asp-action="Detalhes" asp-route-id="@tecnico.Id" class="btn btn-info btn-sm">Detalhes</a>
                    <a asp-action="Editar" asp-route-id="@tecnico.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Excluir" asp-route-id="@tecnico.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>