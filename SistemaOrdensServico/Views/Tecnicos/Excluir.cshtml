@model SistemaOrdensServico.Models.Tecnico

@{
    ViewData["Title"] = "Excluir Técnico";
}

<h1>Excluir Técnico</h1>

<h4>Tem certeza de que deseja excluir este técnico?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>

    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>