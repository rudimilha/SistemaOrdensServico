@model IEnumerable<SistemaOrdensServico.Models.Servico>

@{
    ViewData["Title"] = "Serviços";
}

<h1>Serviços</h1>

<p>
    <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar Novo Serviço</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Valor</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var servico in Model)
        {
            <tr>
                <td>@servico.Nome</td>
                <td>@servico.Descricao</td>
                <td>@servico.Valor.ToString("C")</td>
                <td>
                    <a asp-action="Detalhes" asp-route-id="@servico.Id" class="btn btn-info btn-sm">Detalhes</a>
                    <a asp-action="Editar" asp-route-id="@servico.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Excluir" asp-route-id="@servico.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>