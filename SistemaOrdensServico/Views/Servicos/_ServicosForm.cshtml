@model SistemaOrdensServico.Models.Servico

<div class="mb-3">
    <label asp-for="Nome" class="form-label">Nome</label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descricao" class="form-label">Descrição</label>
    <textarea asp-for="Descricao" class="form-control"></textarea>
    <span asp-validation-for="Descricao" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Valor" class="form-label">Valor</label>
    <input asp-for="Valor" class="form-control" type="number" step="0.01" />
    <span asp-validation-for="Valor" class="text-danger"></span>
</div>