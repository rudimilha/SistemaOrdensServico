@model SistemaOrdensServico.Models.Equipamento

<div class="mb-3">
    <label asp-for="Nome" class="form-label">Nome</label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Marca" class="form-label">Marca</label>
    <input asp-for="Marca" class="form-control" />
    <span asp-validation-for="Marca" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Modelo" class="form-label">Modelo</label>
    <input asp-for="Modelo" class="form-control" />
    <span asp-validation-for="Modelo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="NumeroSerie" class="form-label">Número de Série</label>
    <input asp-for="NumeroSerie" class="form-control" />
    <span asp-validation-for="NumeroSerie" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ClienteId" class="form-label">Cliente</label>

    <select asp-for="ClienteId"
            asp-items="ViewBag.ClienteId"
            class="form-select">
        <option value="">Selecione um cliente</option>
    </select>

    <span asp-validation-for="ClienteId" class="text-danger"></span>
</div>