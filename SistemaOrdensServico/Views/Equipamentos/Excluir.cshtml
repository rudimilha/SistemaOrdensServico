@model SistemaOrdensServico.Models.Equipamento

@{
    ViewData["Title"] = "Excluir Equipamento";
}

<h1>Excluir Equipamento</h1>

<h4>Tem certeza de que deseja excluir este equipamento?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">Marca</dt>
    <dd class="col-sm-9">@Model.Marca</dd>

    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Modelo</dd>

    <dt class="col-sm-3">Número de Série</dt>
    <dd class="col-sm-9">@Model.NumeroSerie</dd>

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente?.Nome</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>