@model SistemaOrdensServico.Models.OrdemServico

@{
    ViewData["Title"] = "Excluir Ordem de Serviço";
}

<h1>Excluir Ordem de Serviço</h1>

<h4>Tem certeza de que deseja excluir esta ordem de serviço?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-3">Número da Ordem</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente?.Nome</dd>

    <dt class="col-sm-3">Equipamento</dt>
    <dd class="col-sm-9">@Model.Equipamento?.Nome</dd>

    <dt class="col-sm-3">Técnico</dt>
    <dd class="col-sm-9">@Model.Tecnico?.Nome</dd>

    <dt class="col-sm-3">Serviço</dt>
    <dd class="col-sm-9">@Model.Servico?.Nome</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>