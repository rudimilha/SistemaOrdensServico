@model SistemaOrdensServico.Models.OrdemServico

@{
    ViewData["Title"] = "Editar Ordem de Serviço";
}

<h1>Editar Ordem de Serviço</h1>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DataAbertura" />
            <input type="hidden" asp-for="DataConclusao" />
            <input type="hidden" asp-for="Status" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="_OrdensServicoForm" model="Model" />

            <button type="submit" class="btn btn-warning">Salvar Alterações</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}