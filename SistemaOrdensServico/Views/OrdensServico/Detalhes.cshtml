@model SistemaOrdensServico.Models.OrdemServico

@{
    ViewData["Title"] = "Detalhes da Ordem de Serviço";
}

<h1>Detalhes da Ordem de Serviço</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">Número da Ordem</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>

    <dt class="col-sm-3">Diagnóstico</dt>
    <dd class="col-sm-9">@Model.Diagnostico</dd>

    <dt class="col-sm-3">Solução</dt>
    <dd class="col-sm-9">@Model.Solucao</dd>

    <dt class="col-sm-3">Data de Abertura</dt>
    <dd class="col-sm-9">
        @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">Data de Conclusão</dt>
    <dd class="col-sm-9">
        @(Model.DataConclusao.HasValue
                ? Model.DataConclusao.Value.ToString("dd/MM/yyyy HH:mm")
                : "Não concluída")
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente?.Nome</dd>

    <dt class="col-sm-3">Equipamento</dt>
    <dd class="col-sm-9">@Model.Equipamento?.Nome</dd>

    <dt class="col-sm-3">Técnico</dt>
    <dd class="col-sm-9">@Model.Tecnico?.Nome</dd>

    <dt class="col-sm-3">Serviço</dt>
    <dd class="col-sm-9">@Model.Servico?.Nome</dd>

</dl>

<hr />

@if (Model.Status != "Concluída")
{
    <div class="card mb-4">

        <div class="card-header">
            Atualizar Status
        </div>

        <div class="card-body">

            <form asp-action="AtualizarStatus" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">

                    <label for="novoStatus" class="form-label">
                        Novo Status
                    </label>

                    <select name="novoStatus"
                            id="novoStatus"
                            class="form-select">

                        <option value="Aberta">Aberta</option>
                        <option value="Em andamento">Em andamento</option>
                        <option value="Concluída">Concluída</option>

                    </select>

                </div>

                <button type="submit" class="btn btn-primary">
                    Atualizar Status
                </button>

            </form>

        </div>

    </div>
}
else
{
    <div class="alert alert-success">
        Esta ordem de serviço está concluída.
    </div>

    <form asp-action="Reabrir" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-success">
            Reabrir Ordem de Serviço
        </button>

    </form>
}

<hr />

@if (Model.Status != "Concluída")
{
    <a asp-action="Editar"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Excluir"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        Excluir
    </a>
}

<a asp-action="Index" class="btn btn-secondary">
    Voltar
</a>